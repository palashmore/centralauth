# ==============================================================================
# CentralAuth — Centralized OAuth 2.1 Identity Provider
# Environment Configuration Template (.env.example)
#
# IMPORTANT:
# - Do NOT put real secrets in this file.
# - Do NOT commit your local '.env.local' or production secret files.
# - SUPABASE_SERVICE_ROLE_KEY is SERVER-SIDE ONLY and MUST NEVER have a NEXT_PUBLIC_ prefix.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Central Supabase Instance Configuration
# ------------------------------------------------------------------------------
# The base URL of your central Supabase project hosting the OAuth 2.1 authorization server.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Supabase Anon / Publishable API Key (safe for browser client initialization).
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Central Identity Provider Origin (Hosting URL for CentralAuth web interface).
# In local development: http://localhost:3000
# In production: https://auth.yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Server-Side Administrative Privileges (STRICTLY CONFIDENTIAL)
# ------------------------------------------------------------------------------
# Supabase Service Role Key: Used EXCLUSIVELY in server-side API routes
# for privileged administrative tasks (e.g. syncing app registry, audit logging).
# NEVER expose this key to browser client code.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 3. OAuth 2.1 Server Metadata (Derived or Configured)
# ------------------------------------------------------------------------------
# Standard OpenID Connect Issuer for token verification
# Usually: https://<your-project-ref>.supabase.co/auth/v1
OAUTH_ISSUER_URL=https://<your-project-ref>.supabase.co/auth/v1

# JWKS (JSON Web Key Set) endpoint for asymmetric RS256/ES256 public key retrieval
OAUTH_JWKS_URI=https://<your-project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Authorization endpoint:
# https://<your-project-ref>.supabase.co/auth/v1/oauth/authorize

# Token exchange endpoint:
# https://<your-project-ref>.supabase.co/auth/v1/oauth/token

# ------------------------------------------------------------------------------
# 4. Environment Identifier
# ------------------------------------------------------------------------------
# Values: development | staging | production
NODE_ENV=development
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 5. Example Consuming Application Configuration (For Reference / Tests)
# ------------------------------------------------------------------------------
# Note: Consuming apps have their own independent environment files.
# For a Public Client (SPA / Mobile):
# CONSUMING_APP_CLIENT_ID=<generated-client-id>
# CONSUMING_APP_REDIRECT_URI=http://localhost:3001/callback
#
# For a Confidential Client (Server Web App / API):
# CONSUMING_APP_CLIENT_ID=<generated-client-id>
# CONSUMING_APP_CLIENT_SECRET=<generated-confidential-secret-never-expose>
